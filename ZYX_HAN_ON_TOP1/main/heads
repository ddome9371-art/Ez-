local function updateBombTimers()
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") or obj.Name:lower():find("bomb") or obj.Name:lower():find("grenade") then
                local targetPart = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if targetPart then
