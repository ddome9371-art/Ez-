local function addKeybindSupport(parentFrame, defaultKey, callback)
    if not isPC then return end
    
    local kbBox = Instance.new("TextBox")
    kbBox.Parent = parentFrame
    kbBox.BackgroundColor3 = Color3.fromRGB(25, 18, 18)
    kbBox.Size = UDim2.new(1, -20, 0, 22)
    kbBox.Position = UDim2.new(0, 10, 1, -26)
    kbBox.Font = Enum.Font.GothamBold
    kbBox.Text = "زر الكيبورد: " .. tostring(defaultKey.Name)
    kbBox.TextColor3 = Color3.fromRGB(200, 200, 200)
    kbBox.TextSize = 10
    Instance.new("UICorner", kbBox).CornerRadius = UDim.new(0, 5)

    local currentKey = defaultKey
    kbBox.Focused:Connect(function()
        kbBox.Text = "اضغط أي زر..."
        kbBox.TextColor3 = Color3.fromRGB(255, 200, 50)
        local connection
        connection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                kbBox.Text = "زر الكيبورد: " .. currentKey.Name
                kbBox.TextColor3 = Color3.fromRGB(200, 200, 200)
                connection:Disconnect()
                kbBox:ReleaseFocus()
            end
        end)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
            if callback then callback() end
        end
    end)
end

