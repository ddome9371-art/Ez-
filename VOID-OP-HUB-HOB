        end)
    end

    createDeviceCard(15,  "PC",      "🖥️")
    createDeviceCard(169, "Mobile",  "📱")
    createDeviceCard(323, "Console", "🎮")

    local applyBtn = Instance.new("TextButton")
    applyBtn.Size = UDim2.new(0.92, 0, 0, 42)
    applyBtn.Position = UDim2.new(0.04, 0, 0, 195)
    applyBtn.BackgroundColor3 = Color3.fromRGB(30, 180, 90)
    applyBtn.BackgroundTransparency = 0.0
    applyBtn.Text = "تطبيق الجهاز وتفعيل Active ⚡"
    applyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    applyBtn.TextSize = 13
    applyBtn.Font = Enum.Font.GothamBold
    applyBtn.Parent = menuFrame

    addUIGradient(applyBtn)

    local applyCorner = Instance.new("UICorner")
    applyCorner.CornerRadius = UDim.new(0, 12)
    applyCorner.Parent = applyBtn

    applyBtn.MouseButton1Click:Connect(function()
        playClickSound()
        applyTrueDeviceSpoof(selectedChoice)
        showCenterShiftLockIcon()
        
        title.Text = "🟢 VOID OP HUB [Active: " .. selectedChoice .. "]"
        title.TextColor3 = Color3.fromRGB(0, 255, 100)
        
        showToast("تم تفعيل الجهاز بنجاح وأصبح Active!")
    end)
end

openDeviceSpooferMenu()
