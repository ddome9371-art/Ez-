--[[
    Script: VOID OP HUB - Clean UI & No Rejoin Version
    Game ID: 11379739543
]]--

if game.PlaceId ~= 11379739543 then return end

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local LocalPlayer = Players.LocalPlayer

-- وظيفة محاكاة المنصة
local function applyTrueDeviceSpoof(deviceName)
    pcall(function()
        if deviceName == "PC" then
            UserInputService.TouchEnabled = false
            UserInputService.MouseEnabled = true
            GuiService:SetEmulateGamepad(false)
        elseif deviceName == "Mobile" then
            UserInputService.TouchEnabled = true
            UserInputService.MouseEnabled = false
            GuiService:SetEmulateGamepad(false)
        elseif deviceName == "Console" then
            UserInputService.TouchEnabled = false
            GuiService:SetEmulateGamepad(true)
        end
    end)
end

local mainGui = Instance.new("ScreenGui")
mainGui.Name = "VoidOpHubCleanGui"
mainGui.ResetOnSpawn = false
pcall(function() mainGui.Parent = CoreGui end)
if not mainGui.Parent then mainGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

-- خلفية الواجهه الرئيسية بالصورة المطلوبة فقط
local BG_IMAGE_ID = "rbxassetid://121235183659027"

local function playClickSound()
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://6042457223"
        sound.Volume = 0.6
        sound.Parent = SoundService
        sound:Play()
        task.delay(1, function() sound:Destroy() end)
    end)
end

local function addBackgroundToFrame(parent)
    local bg = Instance.new("ImageLabel")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundTransparency = 1
    bg.Image = BG_IMAGE_ID
    bg.ScaleType = Enum.ScaleType.Slice
    bg.SliceCenter = Rect.new(100, 100, 100, 100)
    bg.ZIndex = math.max(1, parent.ZIndex - 1)
    bg.Parent = parent

    local corner = Instance.new("UICorner")
    local parentCorner = parent:FindFirstChildOfClass("UICorner")
    corner.CornerRadius = parentCorner and parentCorner.CornerRadius or UDim.new(0, 14)
    corner.Parent = bg
    return bg
end

local function addUIGradient(parent, rotation)
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(160, 90, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(220, 100, 200)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 180, 255))
    })
    grad.Rotation = rotation or 45
    grad.Parent = parent
    return grad
end

local function showCenterShiftLockIcon()
    if CoreGui:FindFirstChild("VoidCenterShiftLock") then return end
    
    local lockGui = Instance.new("ScreenGui")
    lockGui.Name = "VoidCenterShiftLock"
    lockGui.ResetOnSpawn = false
    pcall(function() lockGui.Parent = CoreGui end)
    if not lockGui.Parent then lockGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local outerCircle = Instance.new("Frame")
    outerCircle.Size = UDim2.new(0, 36, 0, 36)
    outerCircle.Position = UDim2.new(0.5, -18, 0.5, -18)
    outerCircle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    outerCircle.BackgroundTransparency = 0.4
    outerCircle.ZIndex = 999
    outerCircle.Parent = lockGui

    local outCorner = Instance.new("UICorner")
    outCorner.CornerRadius = UDim.new(1, 0)
    outCorner.Parent = outerCircle

    local outStroke = Instance.new("UIStroke")
    outStroke.Color = Color3.fromRGB(0, 255, 100)
    outStroke.Thickness = 2
    outStroke.Parent = outerCircle

    local innerDot = Instance.new("Frame")
    innerDot.Size = UDim2.new(0, 10, 0, 10)
    innerDot.Position = UDim2.new(0.5, -5, 0.5, -5)
    innerDot.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    innerDot.ZIndex = 1000
    innerDot.Parent = outerCircle

    local inCorner = Instance.new("UICorner")
    inCorner.CornerRadius = UDim.new(1, 0)
    inCorner.Parent = innerDot
end

local function showToast(message)
    local toast = Instance.new("TextLabel")
    toast.Size = UDim2.new(0, 280, 0, 50)
    toast.Position = UDim2.new(1, -295, 1, -80)
    toast.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
    toast.BackgroundTransparency = 0.1
    toast.Text = "⚡ " .. message
    toast.TextColor3 = Color3.fromRGB(255, 255, 255)
    toast.TextSize = 14
    toast.Font = Enum.Font.GothamBold
    toast.ZIndex = 200
    toast.Parent = mainGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = toast

    task.delay(3, function()
        if toast and toast.Parent then toast:Destroy() end
    end)
end

