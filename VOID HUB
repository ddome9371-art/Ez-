local function hasBomb()
    local char = LocalPlayer.Character
    if not char then return false end
    
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and (string.find(string.lower(item.Name), "bomb") or string.find(string.lower(item.Name), "time") or string.find(string.lower(item.Name), "قنبلة")) then
            return true
        end
    end
    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") and (string.find(string.lower(item.Name), "bomb") or string.find(string.lower(item.Name), "time") or string.find(string.lower(item.Name), "قنبلة")) then
            return true
        end
    end
    
    if char:GetAttribute("HasBomb") == true or LocalPlayer:GetAttribute("HasBomb") == true then
        return true
    end
    
    return false 
end

local function getHumanizedPath(startPos, targetPos)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    
    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end

    local direction = (targetPos - startPos)
    local raycastResult = workspace:Raycast(startPos, direction.Unit * math.min(direction.Magnitude, 6), raycastParams)

    if raycastResult then
        local normal = raycastResult.Normal
        local evadeOffset = (targetPos + (normal * 8))
        return evadeOffset
    end

    return targetPos
end

local function getBestTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = myChar.HumanoidRootPart

    local bestTarget = nil
    local shortestDist = math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            local targetHum = p.Character.Humanoid
            local targetRoot = p.Character.HumanoidRootPart
            
            if targetHum.Health > 0 then
                local sameTeam = (p.Team and p.Team == LocalPlayer.Team)
                
                if not sameTeam then
                    local dist = (targetRoot.Position - myRoot.Position).Magnitude
                    
                    if dist < 220 then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterType = RaycastFilterType.Exclude
                        rayParams.FilterDescendantsInstances = {myChar, p.Character}
                        local obstruction = workspace:Raycast(myRoot.Position, (targetRoot.Position - myRoot.Position), rayParams)
                        
                        if dist < shortestDist then
                            shortestDist = dist
                            bestTarget = p.Character
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

