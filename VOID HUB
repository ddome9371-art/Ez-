        predictionPart.Parent = nil
        return
    end

    if (assistActive or autoActive) and target:FindFirstChild("HumanoidRootPart") then
        local tRoot = target.HumanoidRootPart
        local tVel = tRoot.Velocity
        local rawPredicted = tRoot.Position + (tVel * 0.15)
        local safeMovePos = getHumanizedPath(root.Position, rawPredicted)

        predictionPart.Position = safeMovePos
        predictionPart.Parent = workspace

        if assistActive and humanoid then
            humanoid:MoveTo(safeMovePos)
        end

        if autoActive and humanoid then
            humanoid:MoveTo(safeMovePos)
        end
    else
        predictionPart.Parent = nil
    end

    if lockActive and target and target:FindFirstChild("HumanoidRootPart") then
        local tPos = target.HumanoidRootPart.Position
        local currentPos = root.Position
        local lookAtPos = Vector3.new(tPos.X, currentPos.Y, tPos.Z)
        root.CFrame = CFrame.new(currentPos, lookAtPos)
    end
end)

