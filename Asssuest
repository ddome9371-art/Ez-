-- التحقق من امتلاك القنبلة بدقة متناهية
local function hasBomb(player)
    if not player or not player.Character then return false end
    local char = player.Character
    if char:FindFirstChild("Bomb") or char:FindFirstChild("Timebomb") or LocalPlayer.Backpack:FindFirstChild("Bomb") or LocalPlayer.Backpack:FindFirstChild("Timebomb") then
        return true
    end
    if player:GetAttribute("HasBomb") == true or char:GetAttribute("HasBomb") == true then
        return true
    end
    return false
end

-- استهداف أقرب خصم صالح وتجاهل غير المسموحين (الميتين، الـ FFA، التيم، ومن معه القنبلة)
local function getBestTarget()
    local targetChar = nil
    local targetPlayer = nil
    local shortestDist = math.huge
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local isTeammate = (p.Team and p.Team == LocalPlayer.Team)
                local enemyHasBomb = hasBomb(p)
                
                if not isTeammate and not enemyHasBomb then
                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        targetChar = p.Character.HumanoidRootPart
                        targetPlayer = p
                    end
                end
            end
        end
    end
    return targetChar, targetPlayer
end

-- تشغيل المحرك الذكي الأقصى (Godmode Stealth + Anti-Wall Glitch + Free Movement)
RunService.RenderStepped:Connect(function()
    if not assistEnabled then 
        StatusLabel.Text = "Status: Disabled"
        StatusLabel.TextColor3 = Color3.fromRGB(192, 192, 192)
        return 
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChildOfClass("Humanoid") then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char.HumanoidRootPart
    
    -- الشرط الحديدي: لا يشتغل أبداً إلا إذا كانت القنبلة معك أنت
    if hasBomb(LocalPlayer) then
        StatusLabel.Text = "Status: [ ACTIVE ] - Godmode Max"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
        
        local targetRoot, targetPlayer = getBestTarget()
        if targetRoot and targetPlayer then
            TargetLabel.Text = "Target: " .. targetPlayer.Name
            pcall(function()
                local content = Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                TargetAvatar.Image = content
            end)
            
            -- نظام فحص العوائق والجدران الذكي (Raycast لمنع التعليق نهائياً)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char, targetRoot.Parent}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            
            local raycastResult = workspace:Raycast(rootPart.Position, (targetRoot.Position - rootPart.Position), raycastParams)
            local playerVelocity = rootPart.Velocity.Magnitude
            
            if raycastResult then
                -- إذا كان الخصم خلف جدار: التفاف ذكي فوري لمنطقة مفتوحة بالمللي لمنع التعليق والانفجار
                local evasionPos = targetRoot.Position + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))
                humanoid:MoveTo(evasionPos)
            else
                -- حرية حركة كاملة؛ إذا وقفت لجزء من البند، يتدخل الأسيست لوضعك خلف الخصم بالمسافة الآمنة وتسليم القنبلة
                if playerVelocity < 2 then
                    local offsetDirection = (rootPart.Position - targetRoot.Position).Unit
                    local desiredPosition = targetRoot.Position + (offsetDirection * 2.0)
                    humanoid:MoveTo(desiredPosition)
                end
            end
        else
            TargetLabel.Text = "Target: None"
            TargetAvatar.Image = "rbxassetid://0"
        end
    else
        StatusLabel.Text = "Status: [ WAITING ] - Need Bomb"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
        TargetLabel.Text = "Target: None"
        TargetAvatar.Image = "rbxassetid://0"
    end
end)

-- نظام السحب والتحريك السلس للواجهة للجوال والكمبيوتر
local dragging, dragInput, dragStart, startPos

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
